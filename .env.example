# Copia este archivo a .env y cambia las claves:
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
#
# Solo se aplican la PRIMERA vez que arranca MySQL con el volumen vacío. Para
# cambiarlas después hay que recrear el volumen (`docker compose down -v`,
# que BORRA los datos) o cambiarlas con ALTER USER dentro de MySQL.

MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_PASSWORD=cambia-esta-clave-alumno
